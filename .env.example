AGENTSUPPORT_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agentsupport
AGENTSUPPORT_PERSISTENCE_MODE=postgres
AGENTSUPPORT_AUTO_CREATE_SCHEMA=false
AGENTSUPPORT_EXECUTION_MODE=distributed
AGENTSUPPORT_REDIS_URL=redis://localhost:6379/0
AGENTSUPPORT_RUNTIME_DRIVER=docker_cli
AGENTSUPPORT_RUNTIME_CONTEXT=desktop-linux
AGENTSUPPORT_CORE_RUNNER_TIMEOUT_SECONDS=300
AGENTSUPPORT_WORKSPACE_ROOT=workspace-data
AGENTSUPPORT_WAITING_INPUT_TIMEOUT_SECONDS=1800
AGENTSUPPORT_PAUSE_WORKER_INTERVAL_SECONDS=5
AGENTSUPPORT_HEALTH_CHECK_INTERVAL_SECONDS=5
AGENTSUPPORT_HEALTH_FAILURE_THRESHOLD=3
AGENTSUPPORT_SKILLS_ROOT=skills
AGENTSUPPORT_ENABLED_SKILLS=
AGENTSUPPORT_MAX_ACTIVE_SESSIONS=2
AGENTSUPPORT_MAX_QUEUED_CONVERSATIONS=100
# API 鉴权契约：平台有意不提供 token 鉴权，仅支持 none；配成其他值会启动失败
AGENTSUPPORT_API_AUTH_MODE=none
# 缺失前置条件自动补全（默认开启）：调用任意资源创建接口时，不存在的
# workspace/session/project/user/organization 会按需创建；设为 false 恢复严格 404
AGENTSUPPORT_AUTO_CREATE_MISSING=true
# 自动补全作用域：all 或逗号分隔的 organization,user,preset,project,workspace,session
AGENTSUPPORT_AUTO_CREATE_SCOPES=all
# 可选的稳定默认资源 ID（不设置时使用派生的稳定 UUID，重复调用收敛到同一实体）
AGENTSUPPORT_DEFAULT_WORKSPACE_ID=
AGENTSUPPORT_DEFAULT_USER_ID=
# 自动创建资源的默认名称
AGENTSUPPORT_AUTO_RESOURCE_NAME=auto
AGENTSUPPORT_JOB_LEASE_SECONDS=30
AGENTSUPPORT_JOB_HEARTBEAT_SECONDS=10
AGENTSUPPORT_WORKER_POLL_INTERVAL_SECONDS=0.25
AGENTSUPPORT_EVENT_POLL_INTERVAL_SECONDS=0.25
AGENTSUPPORT_MAX_JOB_ATTEMPTS=3
# Retention windows for transient coordination state (0 disables a window)
AGENTSUPPORT_RETENTION_IDEMPOTENCY_HOURS=24
AGENTSUPPORT_RETENTION_UNREFERENCED_CHECKPOINTS_HOURS=24
AGENTSUPPORT_RETENTION_CLEANUP_INTERVAL_HOURS=24
AGENTSUPPORT_RETENTION_PUBLISHED_OUTBOX_DAYS=7
AGENTSUPPORT_RETENTION_TERMINAL_JOBS_DAYS=30
AGENTSUPPORT_RETENTION_TERMINAL_EVENTS_DAYS=90
# Runner self-registration (internal contract). A non-empty control-plane token
# enables /runners/register|heartbeat; leave empty to keep the static runner URL.
AGENTSUPPORT_RUNNER_TOKEN=
AGENTSUPPORT_RUNNER_HEARTBEAT_TIMEOUT_SECONDS=30
# Runner-side registration settings (SESSION_RUNNER_TOKEN is the same secret as
# AGENTSUPPORT_RUNNER_TOKEN when both sides share a deployment).
SESSION_RUNNER_TOKEN=
SESSION_RUNNER_ENDPOINT=
SESSION_RUNNER_PROVIDER=
SESSION_RUNNER_VERSION=0.1.0
SESSION_RUNNER_HEARTBEAT_SECONDS=10
AGENTSUPPORT_CONTROL_PLANE_URL=
TRAE_PROVIDER=anthropic
TRAE_MODEL=claude-sonnet-4-20250514
TRAE_MODEL_BASE_URL=
TRAE_API_KEY=
